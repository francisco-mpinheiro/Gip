// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma" // Descomente se ainda precisar da saída customizada
}

datasource db {
  provider = "postgresql"
 
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  admin_platform
  admin_company
  manager_area
  project_manager
  employee
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  pendingEmail String?
  emailToken    String?
  emailTokenExpiry DateTime?
  resetToken     String?
  resetTokenExpiry DateTime?
  cpf        String   @unique
  password   String
  role       Role     @default(employee)
  department String?  // Opcional, pois nem todo usuário tem (ex: Admin Plataforma)
  avatar     String?  // Opcional
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // Gerenciado automaticamente pelo Prisma

  // Relacionamentos sugeridos
  managedProjects Project[] @relation("ProjectManager")
  memberProjects  Project[] @relation("ProjectMembers")
  tasks           Task[]
  activities      Activity[]
  comments        Comment[]
  notifications   Notification[]
  attachments     TaskAttachment[]
  educations      Education[]

  projectIssues ProjectIssue[]
  createdDependencies TaskDependency[]
  submittedReviews TaskReview[] @relation("ReviewAuthor")
  reviewedSubmissions TaskReview[] @relation("ReviewReviewer")
  checkIns ProjectCheckIn[]
  projectNotes ProjectNote[]
  departmentRequests DepartmentRequest[]

  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@map("users")
}

model Education {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  startDate    DateTime?
  endDate      DateTime?
  certificateUrl String?
  createdAt    DateTime @default(now())

  @@map("educations")
}


model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("planejamento")
  priority    String   @default("media")
  progress    Int      @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  managerId   String
  manager     User     @relation("ProjectManager", fields: [managerId], references: [id])
  
  members     User[]   @relation("ProjectMembers")
  
  tasks       Task[]
  activities  Activity[]
  notifications Notification[]

  issues ProjectIssue[]
  dependencies TaskDependency[]
  reviews TaskReview[]
  checkIns ProjectCheckIn[]
  notes ProjectNote[]
  departmentRequests DepartmentRequest[]

  @@map("projects")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("a_fazer")
  priority    String   @default("media")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  
  activities  Activity[]
  comments    Comment[]
  notifications Notification[]
  attachments   TaskAttachment[]

  issues ProjectIssue[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents TaskDependency[] @relation("TaskDependents")
  reviews TaskReview[]

  @@map("tasks")
}

model Activity {
  id          String   @id @default(uuid())
  action      String
  target      String
  createdAt   DateTime @default(now())

  // Relacionamentos
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id])

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  @@map("activities")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])

  @@map("comments")
}

model Notification {
  id        String   @id @default(uuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  @@map("notifications")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("task_attachments")
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)

  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@map("messages")
}

model ProjectIssue {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId String?
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  title String
  reason String
  status String @default("open")
  resolution String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([projectId, status])
  @@map("project_issues")
}

model TaskDependency {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId String
  task Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn Task @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  @@unique([taskId, dependsOnId])
  @@index([projectId])
  @@map("task_dependencies")
}

model TaskReview {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation("ReviewAuthor", fields: [authorId], references: [id])
  reviewerId String?
  reviewer User? @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  summary String
  evidence String?
  status String @default("pending")
  feedback String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([projectId, status])
  @@index([taskId, createdAt])
  @@map("task_reviews")
}

model ProjectCheckIn {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  day String
  completed String
  nextStep String
  needsHelp String?
  createdAt DateTime @default(now())
  @@unique([projectId, authorId, day])
  @@map("project_check_ins")
}

model ProjectNote {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  kind String
  title String
  content String
  createdAt DateTime @default(now())
  @@index([projectId, kind])
  @@map("project_notes")
}

model DepartmentRequest {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  fromDepartment String
  toDepartment String
  title String
  description String
  priority String @default("media")
  status String @default("open")
  resolution String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([projectId, status])
  @@index([toDepartment, status])
  @@map("department_requests")
}
